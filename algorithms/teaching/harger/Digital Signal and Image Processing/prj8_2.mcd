{\f1\fnil Symbol;}
}
{\plain {\b prj8_2.mcd}{  to find the pole-zero
 pattern of a second order difference FIR
 that approximates a second-derivative operation
 over a certain range of frequencies.}}
}
.EQN 6 9 3 0
({0:h}NAME)[(0):1
.EQN 0 9 4 0
({0:h}NAME)[(1):-2
.EQN 0 10 5 0
({0:h}NAME)[(2):1
.EQN 5 -19 13 0
{0:M}NAME:2
.EQN 0 9 14 0
{0:m}NAME:0;{0:M}NAME-1
.EQN 0 14 15 0
{0:N}NAME:{0:M}NAME+1
.EQN 0 13 16 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 3 -30 18 0
&&(_n_u_l_l_&_n_u_l_l_)&({0:h}NAME)[({0:n}NAME)@&&(_n_u_l_l_&_n_u_l_l_)&{0:n}NAME
