({0:d2s}NAME)[({0:k}NAME):-(({0:\w.1}NAME))^(2)*{0:cos}NAME({0:\w.1}NAME*{0:k}NAME)+-(({0:\w.2}NAME))^(2)*{0:cos}NAME({0:\w.2}NAME*{0:k}NAME)
