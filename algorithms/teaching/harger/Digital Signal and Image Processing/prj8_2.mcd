0 1 43 15 0 3 Second Derivative FIR
.TXT 28 -10 19 0
Cg a64.500000,68.000000,104
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We see that this FIR is even about
 its midpoint and M is even: therefore it
 is a Type I FIR filter. }}
}
.TXT 9 0 6 0
Cg a20.000000,68.000000,32
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The transfer function is then}}
}
.EQN 0 28 7 0
{0:H}NAME({0:z}NAME):((0,2,{0:n}NAME,({0:h}NAME)[({0:n}NAME)*({0:z}NAME)^(-{0:n}NAME)){64})
.TXT 7 -28 8 0
Cg a1.375000,68.000000,5
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {or}}
}
.EQN 5 12 9 0
{0:H}NAME({0:z}NAME):(((0,2,{0:n}NAME,({0:h}NAME)[({0:n}NAME)*({0:z}NAME)^(2-{0:n}NAME)){64}))/(({0:z}NAME)^(2))
.TXT 6 -12 10 0
Cg a60.000000,68.000000,217
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {So h}{\fs16 \dn6 0}{ is the coeficient
 of z}{\fs16 \up6 2}{, h}{\fs16 \dn6 1}{
 is the coeficient of z and h}{\fs16 \dn6 
2}{ is the constant term. \par For the vector
 v to be used in polyroots(v) we want the
 reverse order.}}
}
.EQN 8 4 11 0
({0:v}NAME)[({0:n}NAME):({0:h}NAME)[(2-{0:n}NAME)
.EQN 0 19 12 0
{0:polyroots}NAME({0:v}NAME)={0}?_n_u_l_l_
.TXT 6 -23 17 0
Cg a33.875000,67.000000,54
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {So, we have a }{\b second order
 singlet}{ at z=+1. }}
}
.TXT 7 0 20 0
Cg a65.625000,68.000000,195
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The frequency response is of interest.
 In particular, we would like to compare
 it to the ideal second order differentiator,
 which has FR (i}{\f1 w}{)}{\fs16 \up6 2}{
 = -}{\f1 w}{\fs16 \up6 2}{.}}
}
.EQN 8 2 22 0
{0:K}NAME:256
