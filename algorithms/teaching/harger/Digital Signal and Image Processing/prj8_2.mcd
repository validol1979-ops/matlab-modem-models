{\f1\fnil Symbol;}
}
{\plain {We see that the FIR filter "works"
 as a second order differentiator only over
 a lowpass band of frequencies. We give 
an example.}}
}
.EQN 8 7 54 0
{0:\w.1}NAME:(2*{0:\p}NAME)/({0:K}NAME)*4
.EQN 0 13 60 0
{0:\w.1}NAME={0}?_n_u_l_l_
.EQN 0 13 57 0
{0:\w.2}NAME:(2*{0:\p}NAME)/({0:K}NAME)*8
.EQN 0 13 61 0
{0:\w.2}NAME={0}?_n_u_l_l_
.EQN 7 -39 32 0
({0:s}NAME)[({0:k}NAME):{0:cos}NAME({0:\w.1}NAME*{0:k}NAME)+2*{0:cos}NAME({0:\w.2}NAME*{0:k}NAME)
.TXT 6 -7 62 0
Cg a41.875000,68.000000,61
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The approximate second order derivative
 is the FIR output.}}
}
.EQN 7 11 47 0
({0:d2sa}NAME)[({0:k}NAME):((0,{0:M}NAME,{0:n}NAME,({0:h}NAME)[({0:n}NAME)*{0:if}NAME({0:k}NAME-{0:n}NAME<0,0,({0:s}NAME)[({0:k}NAME-{0:n}NAME))){64})
