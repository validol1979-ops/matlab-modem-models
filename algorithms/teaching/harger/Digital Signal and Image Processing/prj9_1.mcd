.TXT 2 1 1 0
Cg a47.250000,73.000000,76
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {\b prj9_1.mcd}{  to show a simple
 design of a differentiating FIR filter.}}
}
.TXT 4 4 2 0
Cg a55.375000,73.000000,85
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The derivative of an analog waveform
 is defined as a limit of a finite difference:}}
}
.EQN 4 0 13 0
{0:\n.1}NAME:2*{0:\p}NAME*(10)^(6)
.EQN 0 14 14 0
{0:\n.2}NAME:2*{0:\n.1}NAME
.EQN 0 14 21 0
{0:s.a}NAME({0:t}NAME):{0:cos}NAME({0:\n.1}NAME*{0:t}NAME)+2*{0:cos}NAME({0:\n.2}NAME*{0:t}NAME)
.EQN 6 -11 5 0
{0:t}NAME"{0:s.a}NAME({0:t}NAME)÷((0,{0:T.s}NAME,({0:s.a}NAME({0:t}NAME)-{0:s.a}NAME({0:t}NAME-{0:T.s}NAME))/({0:T.s}NAME)){68})
.TXT 6 -16 9 0
Cg a65.875000,66.250000,448
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We approximate the derivative with
 a finite difference, after sampling the
 analog waveform. We know that we have to
 have a sample frequency larger than twice
 the highest frequency- }{\f1 n}{\fs16 \dn6 
2}{ in our example- in order to reconstruct
 the waveform. But clearly the derivative
 is more accurately computed as the sample
 frequency }{\f1 n}{\fs16 \dn6 s}{ gets 
very large- }{\f1 ¥}{ in the limit. So introduce
 a }{\b sampling factor}{ f.}}
}
.EQN 13 0 10 0
{0:N}NAME:128
.EQN 0 7 11 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 10 23 0
{0:f}NAME:7
.EQN 0 5 22 0
{0:\n.s}NAME:{0:f}NAME*2*{0:\n.2}NAME
.EQN 0 10 24 0
{0:T.s}NAME:(2*{0:\p}NAME)/({0:\n.s}NAME)
.EQN 0 8 25 0
{0:T.s}NAME={0}?_n_u_l_l_
.EQN 0 16 26 0
({0:s}NAME)[({0:n}NAME):{0:s.a}NAME({0:n}NAME*{0:T.s}NAME)
.TXT 6 -56 27 0
Cg a39.625000,73.000000,61
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The finite difference approximating
 the derivative is then}}
}
.EQN 5 7 28 0
({0:sd}NAME)[({0:n}NAME):(1)/({0:T.s}NAME)*{0:if}NAME({0:n}NAME÷0,({0:s}NAME)[(1)-({0:s}NAME)[(0),({0:s}NAME)[({0:n}NAME)-({0:s}NAME)[({0:n}NAME-1))
.TXT 5 -6 29 0
Cg a48.625000,73.000000,74
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {This operation can be interpreted
 (for n>0) as an FIR filtering with IR}}
}
.EQN 6 7 35 0
{0:M}NAME:1
.EQN 0 8 36 0
{0:m}NAME:0;{0:M}NAME
.EQN 0 15 30 0
({0:h}NAME)[(0):(1)/({0:T.s}NAME)
.EQN 0 10 31 0
({0:h}NAME)[(1):-((1)/({0:T.s}NAME))
.TXT 5 -39 37 0
Cg a16.875000,73.000000,28
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The transfer function is }}
}
.EQN 5 6 38 0
{0:H}NAME({0:z}NAME):((0,{0:M}NAME,{0:m}NAME,({0:h}NAME)[({0:m}NAME)*({0:z}NAME)^(-{0:m}NAME)){64})
.TXT 6 -5 39 0
Cg a17.500000,73.000000,29
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {which in rational form is }}
}
.EQN 5 5 40 0
{0:H}NAME({0:z}NAME):(({0:h}NAME)[(0)*{0:z}NAME+({0:h}NAME)[(1))/({0:z}NAME)
.TXT 5 -6 41 0
Cg a60.375000,64.750000,164
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {There is a pole at z=0 and a zero
 at z=-h1/h0=1. }{\ul Therefore, this FIR
 is the simplest possible Type IV possible!}{\ulnone 
  The pole-zero plot is very simple.}}
}
.EQN 8 6 42 0
{0:K}NAME:{0:N}NAME
.EQN 0 10 43 0
{0:k}NAME:0;{0:K}NAME-1
.EQN 0 11 44 0
({0:\w}NAME)[({0:k}NAME):-{0:\p}NAME+{0:k}NAME*((2*{0:\p}NAME)/({0:K}NAME))
.EQN 3 -14 45 0
1.2&-1.2&(_n_u_l_l_&_n_u_l_l_)&{0:sin}NAME(({0:\w}NAME)[({0:k}NAME)),0,0@1.2&-1.2&(_n_u_l_l_&_n_u_l_l_)&{0:cos}NAME(({0:\w}NAME)[({0:k}NAME)),0,1
