.TXT 36 -14 47 0
Cg a54.625000,67.000000,79
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The frequency response is of paramount
 interest.} It is easy to compute it as}
}
.EQN 5 10 116 0
{0:H1}NAME({0:\w}NAME):2*({0:e}NAME)^(-1i*({0:\w}NAME)/(2)+1i*({0:\p}NAME)/(2))*{0:sin}NAME({0:\w}NAME)
.TXT 5 -10 117 0
Cg a66.250000,66.250000,124
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {\b Exercise}  Given the transfer
 function above, verify this frequency response
 using Mathcad's symbolic math capability.}
}
.TXT 7 0 118 0
Cg a62.625000,66.250000,173
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain Since this FIR filter has length
 M+1=2, we expect the phase due to causality,
 namely, {\f1 w}M/2 = {\f1 w}/2. Also, as
 the FIR is odd, we expect the {\f1 p}/2
 phase shift.}
}
.TXT 7 0 119 0
Cg a30.875000,66.250000,40
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain We now plot the FR magnitude and
 phase.}
}
.EQN 6 11 48 0
({0:Hs}NAME)[({0:k}NAME):{0:H}NAME(({0:e}NAME)^(1i*({0:\w}NAME)[({0:k}NAME)))
.EQN 4 -8 49 0
