{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\b \f0 420seq.}{\f1 \b m}{\f0 \b 
cd} to demonstrate lmse equalization. The
 channel model is an autoregressive model
 and the equalizer is an FIR filter.}
}
.EQN 1 0 1 0
_n_u_l_l_
.TXT 6 3 3 0
Cg a47.375000,53.125000,71
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\b \f0 1} Define the symbol sequence,
 a random sequence of 0s and 1s.}
}
.EQN 5 5 4 0
{0:K}NAME:64
.EQN 0 11 5 0
{0:k}NAME:0;2*{0:K}NAME
.EQN 0 15 6 0
({0:r}NAME)[({0:k}NAME):{0:if}NAME({0:rnd}NAME(1)<0.5,0,1)
.TXT 5 -30 7 0
Cg a57.875000,57.875000,160
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\b \f0 2} Compute the output of
 the channel. The channel model is a simple,
 first order AR filter, with a real pole
 at z = {\f2 r}{\f2 } and a zero at z = 
0.}
}
.EQN 7 4 8 0
{0:kk}NAME:1;2*{0:K}NAME
.EQN 0 13 9 0
{0:\r}NAME:0.1
.EQN 0 10 10 0
({0:y}NAME)[(0):({0:r}NAME)[(0)
.EQN 0 12 11 0
({0:y}NAME)[({0:kk}NAME):{0:\r}NAME*({0:y}NAME)[({0:kk}NAME-1)+({0:r}NAME)[({0:kk}NAME)
.TXT 7 -39 12 0
Cg a36.500000,56.375000,60
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\b \f0 3} Determine the equalization
 filter, assuming N=1.}
}
.EQN 4 4 13 0
{0:N}NAME:1
.EQN 0 17 14 0
{0:m}NAME:0;2*{0:N}NAME
.EQN 0 26 15 0
{0:n}NAME:0;2*{0:N}NAME
.EQN 6 -43 16 0
({0:\G}NAME)[({0:m}NAME,{0:n}NAME):{0:k}NAME$({0:k}NAME-{0:m}NAMEò0)*({0:k}NAME-{0:n}NAMEò0)*({0:y}NAME)[({0:k}NAME-{0:m}NAME)*({0:y}NAME)[({0:k}NAME-{0:n}NAME)
.EQN 7 0 17 0
({0:P}NAME)[({0:m}NAME):{0:k}NAME$({0:k}NAME-{0:m}NAMEò0)*({0:r}NAME)[({0:k}NAME)*({0:y}NAME)[({0:k}NAME-{0:m}NAME)
.EQN 7 1 18 0
{0:h}NAME:({0:\G}NAME)^(-1)*{0:P}NAME
.EQN 0 24 19 0
{0:h}NAME={18998}?_n_u_l_l_
.TXT 9 -27 20 0
Cg a65.250000,65.625000,181
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\f1 The FIR filter which is the
 inverse of the autoregressive filter has
 exactly these tap weights (to 6 significant
 digits) !!} It has a zero at z = {\f2 r}
 and a pole at z = 0.}
}
.TXT 6 0 21 0
Cg a65.250000,66.750000,120
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\b \f0 4} As a check, suppose we
 run the data sequence thru the filter and
