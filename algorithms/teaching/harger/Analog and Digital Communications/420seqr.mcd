_n_u_l_l_
.TXT 2 0 2 0
Cg a68.875000,69.000000,163
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {420seqr.mcd to demonstrate lmse
 equalization using a recursive LMSE algorithm.
 The channel model is an autoregressive 
model and the equalizer is an FIR filter.}}
}
.TXT 7 4 3 0
Cg a22.375000,52.125000,39
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {}{\b 1}{ Define the symbol sequence.}}
}
.EQN 5 2 4 0
{0:K}NAME:128
.EQN 0 11 5 0
{0:kk}NAME:0;{0:K}NAME
.EQN 0 21 6 0
({0:r}NAME)[({0:kk}NAME):{0:if}NAME({0:rnd}NAME(1)<0.5,0,1)
.TXT 5 -34 7 0
Cg a26.750000,31.750000,46
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {}{\b 2}{ Compute the output of 
the channel.}}
}
.EQN 6 6 8 0
{0:k}NAME:1;{0:K}NAME
.EQN 0 12 9 0
{0:\r}NAME:0.1
.EQN 0 12 10 0
({0:y}NAME)[(0):({0:r}NAME)[(0)
.EQN 0 12 11 0
({0:y}NAME)[({0:k}NAME):{0:\r}NAME*({0:y}NAME)[({0:k}NAME-1)+({0:r}NAME)[({0:k}NAME)
.TXT 6 -41 12 0
Cg a36.125000,44.750000,60
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {}{\b 3}{ Determine the equalization
 filter, assuming N=1.}}
}
.EQN 5 1 14 0
{0:N}NAME:2
.EQN 0 9 15 0
{0:m}NAME:0;{0:N}NAME
.EQN 0 11 16 0
{0:n}NAME:0;{0:N}NAME
.EQN 0 13 17 0
{0:\d}NAME:-1
.EQN 0 10 13 0
({0:h}NAME){52}(0):({3,1}ö1.0ö1.0ö1.0)
.EQN 7 -43 18 0
({0:h}NAME)[({0:m}NAME,{0:k}NAME):({0:h}NAME)[({0:m}NAME,{0:k}NAME-1)-{0:\d}NAME*(({0:r}NAME)[({0:k}NAME-1)-{0:n}NAME$({0:k}NAME-1-{0:n}NAMEò0)*(({0:h}NAME)[({0:n}NAME,{0:k}NAME-1)*({0:y}NAME)[({0:k}NAME-1-{0:n}NAME)))*(({0:k}NAME-1-{0:m}NAMEò0)*(
{0:y}NAME)[({0:k}NAME-1-{0:m}NAME))
.EQN 11 0 19 0
({0:h}NAME){52}(({0:K}NAME)/(2))={0}?_n_u_l_l_
.EQN 0 19 20 0
({0:h}NAME){52}({0:K}NAME-1)={0}?_n_u_l_l_
.EQN 0 22 21 0
({0:h}NAME){52}({0:K}NAME)={0}?_n_u_l_l_
.TXT 9 -41 22 0
Cg a63.500000,67.125000,160
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {The FIR filter which is the inverse
 of the autoregressive filter has exactly
 the tap weights (1,-}{\f2 r}{,0): so the
 estimates are close- but not precise. }}
}
.TXT 9 -1 23 0
Cg a64.875000,66.500000,118
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {\b 4}{ As a check, suppose we run
 the data sequence thru the filter and compare
 its output to the symbol sequence.}}
}
.EQN 7 2 24 0
{0:l}NAME:2;{0:K}NAME
.EQN 0 19 25 0
({0:s}NAME)[(0):({0:h}NAME)[(0,{0:K}NAME)*({0:y}NAME)[(0)
.EQN 0 22 26 0
({0:s}NAME)[(1):({0:h}NAME)[(0,{0:K}NAME)*({0:y}NAME)[(1)+({0:h}NAME)[(1,{0:K}NAME)*({0:y}NAME)[(0)
.EQN 5 -41 27 0
({0:s}NAME)[({0:l}NAME):({0:h}NAME)[(0,{0:K}NAME)*({0:y}NAME)[({0:l}NAME)+({0:h}NAME)[(1,{0:K}NAME)*({0:y}NAME)[({0:l}NAME-1)+({0:h}NAME)[(2,{0:K}NAME)*({0:y}NAME)[({0:l}NAME-2)
.EQN 0 44 28 0
({0:s}NAME)[({0:k}NAME):{0:if}NAME(({0:s}NAME)[({0:k}NAME)<0.5,0,1)
.EQN 7 -44 29 0
({0:\e}NAME)[({0:k}NAME):({0:r}NAME)[({0:k}NAME)-({0:s}NAME)[({0:k}NAME)
.EQN 0 21 30 0
{0:\et}NAME:{0:k}NAME$|(({0:\e}NAME)[({0:k}NAME))
.EQN 0 24 31 0
{0:\et}NAME={0}?_n_u_l_l_
.TXT 7 -47 33 0
Cg a66.375000,66.625000,312
{\rtf1\ansi \deff1
{\fonttbl
{\f0\fnil Courier;}
{\f1\fnil Arial;}
{\f2\fnil Symbol;}
}
{\plain {With the decision rule the error
 is 0, even though the filter coeficients
 have not been precisely estimated. (With
 out the decision step there is more error-
 but really we do want the decision, of 
course.) This is an important observation
 for the next, adaptive, modification of
 the equalization algorithm.}}
}
