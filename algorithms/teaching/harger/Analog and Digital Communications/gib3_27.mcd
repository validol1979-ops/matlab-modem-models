{0:\wo}NAME*{0:\t}NAME)*{0:\w}NAME-{0:sin}NAME((1)/(2)*{0:\w}NAME*{0:\t}NAME+(1)/(2)*{0:\wo}NAME*{0:\t}NAME)*{0:\wo}NAME))/((({0:\w}NAME-{0:\wo}NAME)*({0:\w}NAME+{0:\wo}NAME)))
