{\plain b. {The above calculations were 
done quite quickly on a 486, but could be
 done more rapdly using the DFT- implemented
 by an FFT.  Define the sample sequence 
and the DFT, using MathCAD's FFT. In this
 case, as the pulse is centered on zero,
 we must use "DFT order" in taking samples.}
 }
}
.EQN 11 0 26 0
{0:N}NAME:64
.EQN 0 10 27 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 13 65 0
{0:T.s}NAME:({0:\t}NAME)/({0:N}NAME)
.EQN 0 14 28 0
({0:fs}NAME)[({0:n}NAME):{0:if}NAME({0:n}NAMEó({0:N}NAME)/(2),{0:f}NAME({0:n}NAME*{0:T.s}NAME),{0:f}NAME(({0:N}NAME-{0:n}NAME)*{0:T.s}NAME))
.EQN 6 -27 29 0
{0:dft}NAME({0:v}NAME):\({0:N}NAME)*{0:icfft}NAME({0:v}NAME)
.EQN 0 27 31 0
{0:F.DFT}NAME:{0:dft}NAME({0:fs}NAME)
.TXT 5 -38 66 0
Cg a19.000000,66.000000,25
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
