{\plain So the filter has a nearly linear
 behavior over the spectrum of the FM waveform
 and hopefully will be able to convert the
 FM into AM. We try it, anyway!}
}
.TXT 9 0 16134 0
Cg a53.125000,66.000000,80
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {\b 3}{  Pass the PM waveform thru
 the filter and examine the output waveform:}}
}
.EQN 7 3 26 0
{0:mestft}NAME:(({0:hft}NAME*{0:sfmft}NAME)){49}
.EQN 0 17 27 0
{0:idft}NAME({0:v}NAME):\((1)/({0:N}NAME))*{0:cfft}NAME({0:v}NAME)
