{\plain {\b 2}{  Define the de-tuned filter:
  we choose a very simple filter!:}}
}
.EQN 7 0 20 0
{0:\wf}NAME:{0:W}NAME*40
.EQN 0 13 21 0
{0:\t}NAME:4
.EQN 0 13 22 0
({0:h}NAME)[({0:n}NAME):{0:exp}NAME(-((({0:n}NAME)/({0:\t}NAME)))^(2))*{0:cos}NAME({0:\wf}NAME*{0:n}NAME)
.EQN 0 29 23 0
{0:hft}NAME:{0:dft}NAME({0:h}NAME)
.EQN 6 -50 24 0
&&(_n_u_l_l_&_n_u_l_l_)&|(({0:hft}NAME)[({0:n}NAME))@{0:N}NAME&&(16&40)&{0:n}NAME
