.TXT 6 -45 231 0
Cg a71.100000,73.000000,369
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain sfm(t) is the ideal FM modulated
 signal that would be transmitted.  We now
 add noise to the phase to simulate channel
 irregularities.  Note that there is a factor
 of G in our additive noise.  We did this
 to simulate the fact that the bandwidth
 of the PLL changes in proportion to a change
 in G.  Therefore, as G increases the bandwidth
 increases, thus adding noise.}
}
.EQN 10 10 218 0
{0:Af}NAME:1
.EQN 0 12 241 0
{0:G}NAME:-2
.EQN 0 12 242 0
{0:a}NAME:((1-{0:G}NAME))^(-1)
.EQN 0 18 243 0
{0:b}NAME:{0:G}NAME*{0:a}NAME
.EQN 5 -42 229 0
{0:var}NAME:0.001
.EQN 0 14 244 0
({0:no}NAME)[({0:n}NAME):\(-2*{0:var}NAME*{0:ln}NAME({0:rnd}NAME(1)))*{0:cos}NAME({0:rnd}NAME(2*{0:\p}NAME))*({0:G}NAME)/(10)
.EQN 5 -14 245 0
({0:fms}NAME)[({0:n}NAME):({0:sfms}NAME)[({0:n}NAME)+({0:no}NAME)[({0:n}NAME)
.EQN 5 0 246 0
{0:\f}NAME({0:t}NAME):{0:cf}NAME*{0:intm}NAME({0:t}NAME)
