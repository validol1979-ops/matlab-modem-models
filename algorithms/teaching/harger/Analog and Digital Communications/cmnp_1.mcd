{\plain {ENEE 420\par Project 1\par 2/20/96\par 
\par Angela Cheung\par Hayden Metz\par Joanna
 Nickerson\par Steve Payne}}
}
.TXT 20 0 133 0
Cg a49.800000,73.000000,79
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {Study of the effect truncating 
the sinc signal has on its Fourier Transform.}}
}
.TXT 5 0 11 0
Cg a68.100000,73.000000,114
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {First, we generate a sinc signal.
  Care must be taken to ensure that the 
function is defined for }{\f1 w}{ = 0.}}
}
.EQN 4 6 1 0
{0:N}NAME:128
.EQN 0 11 2 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 15 3 0
({0:\w}NAME)[({0:n}NAME):10*{0:n}NAME*(2*{0:\p}NAME)/(32*{0:\p}NAME)
.EQN 6 -26 9 0
{0:t}NAME:-({0:N}NAME-1);{0:N}NAME-1
.EQN 0 26 10 0
{0:\w}NAME({0:t}NAME):10*{0:t}NAME*(2*{0:\p}NAME)/(32*{0:\p}NAME)
.EQN 5 -26 5 0
{0:sinc}NAME({0:t}NAME):{0:if}NAME({0:t}NAME,({0:sin}NAME({0:\w}NAME({0:t}NAME)))/({0:\w}NAME({0:t}NAME)),1)
.TXT 7 -6 33 0
Cg a59.000000,72.000000,91
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {A plot of this real function can
 be made to confirm the correct signal has
 been created.}}
}
.EQN 1 6 6 0
1.1&-.3&(_n_u_l_l_&_n_u_l_l_)&{0:sinc}NAME({0:t}NAME)@&-127&(_n_u_l_l_&_n_u_l_l_)&{0:t}NAME
