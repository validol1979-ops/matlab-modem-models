Cg a70.900000,72.000000,156
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {To compute the Fourier Transform
 of the sinc signal using the DFT, the real
 function of time sinc(t) must be sampled,
 resulting in the sequence "sincs."}}
}
.EQN 6 6 18 0
({0:sincs}NAME)[({0:n}NAME):{0:sinc}NAME({0:n}NAME)
.EQN 0 19 19 0
{0:FTsinc}NAME:{0:dft}NAME({0:sincs}NAME)
