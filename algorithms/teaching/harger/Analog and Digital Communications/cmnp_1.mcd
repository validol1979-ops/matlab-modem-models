.TXT 10 0 39 0
Cg a54.400000,71.000000,79
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {A communication system can be constructed
 using these truncated sinc pulses:}}
}
.TXT 5 0 54 0
Cg a43.500000,73.000000,68
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {We use a function definition to
 implement an analog  pulse, p(t).}}
}
.EQN 4 5 56 0
{0:pw}NAME:40
.EQN 0 12 57 0
{0:p}NAME({0:t}NAME):{0:\F}NAME({0:t}NAME+({0:pw}NAME)/(2))-{0:\F}NAME({0:t}NAME-({0:pw}NAME)/(2))
.TXT 5 -17 58 0
Cg a55.800000,62.000000,87
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {We use a sum of functions to implement
 a train of truncated sinc pulses, sincpt(t).
 }}
}
.EQN 4 5 60 0
{0:pp}NAME:50
.EQN 4 0 62 0
{0:M}NAME:3
.EQN 0 9 63 0
{0:m}NAME:0;{0:M}NAME-1
.EQN 4 -9 68 0
{0:sincp}NAME({0:t}NAME):{0:sinc}NAME({0:t}NAME)*{0:p}NAME({0:t}NAME)
.EQN 0 20 75 0
{0:sincpt}NAME({0:t}NAME):((-({0:M}NAME-1),{0:M}NAME-1,{0:m}NAME,{0:sincp}NAME({0:t}NAME-{0:pp}NAME*{0:m}NAME)){64})
