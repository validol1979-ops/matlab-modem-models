{\plain {\b dsbsc_am.mcd}{   to illustrate
 DSBSC-AM modulation and demodulation.}}
}
.TXT 4 1 2 0
Cg a54.500000,72.000000,87
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
}
{\plain {\b 1}{  Define the modulation, 
constructing it with a fourier series representation.}}
}
.EQN 6 4 3 0
{0:N}NAME:256
.EQN 0 10 4 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 16 6 0
{0:k}NAME:5;20
.EQN 4 -26 7 0
({0:\wm}NAME)[({0:k}NAME):{0:k}NAME*(2*{0:\p}NAME)/({0:N}NAME)
.EQN 0 10 10 0
({0:\q}NAME)[({0:k}NAME):{0:rnd}NAME(2*{0:\p}NAME)
.EQN 0 16 11 0
({0:c}NAME)[({0:k}NAME):30-{0:k}NAME
.EQN 0 13 12 0
