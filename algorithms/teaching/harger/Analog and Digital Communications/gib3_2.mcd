{\plain {Mathcad has the capability of computing
 Fourier transforms symbolically. The function
 whose FT we wish to compute is}}
}
.EQN 8 20 281 0
({0:e}NAME)^(-|(({0:t}NAME)/({0:\t}NAME)))
.TXT 3 -20 76 0
Cg a60.375000,62.000000,130
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We click on and enclose an instance
 of t in the form and choose "Transforms"
 then "Fourier Transform". We get the evaluation
  }}
}
.EQN 6 15 284 0
(2)/((|({0:\t}NAME)*((1)/(((|({0:\t}NAME)))^(2))+({0:\w}NAME)^(2))))
.TXT 9 -15 286 0
Cg a12.375000,62.000000,19
{\rtf1\ansi \deff0
