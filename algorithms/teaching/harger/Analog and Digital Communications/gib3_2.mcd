}
.EQN 8 14 53 0
{0:F1}NAME({0:\w}NAME):(-{0:\¥}NAME&{0:\¥}NAME`({0:e}NAME)^(-1i*{0:\w}NAME*{0:t}NAME)*({0:e}NAME)^(-|(({0:t}NAME)/({0:\t}NAME)))&{0:t}NAME)
.TXT 6 -13 59 0
Cg a61.625000,64.000000,250
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We click on and enclose the right
 side of this equation, load the symbolic
 processor, and have it evaluate symbolically:
 it fails to find "a closed form"! So we
 try to make it easier by dividing into 
two integrals with temporarily finite limits.}}
}
.EQN 13 0 247 0
{0:F11}NAME({0:\w}NAME):(-{0:b}NAME&0`({0:e}NAME)^(((1)/({0:\t}NAME)-1i*{0:\w}NAME)*{0:t}NAME)&{0:t}NAME)
.EQN 0 28 246 0
{0:F11}NAME({0:\w}NAME):(-{0:\t}NAME)/((1i*{0:\w}NAME*{0:\t}NAME-1))+{0:\t}NAME*({0:exp}NAME({0:b}NAME*((1i*{0:\w}NAME*{0:\t}NAME-1))/({0:\t}NAME)))/((1i*{0:\w}NAME*{0:\t}NAME-1))
.EQN 11 -28 248 0
{0:F12}NAME({0:\w}NAME):(0&{0:b}NAME`({0:e}NAME)^(-(((1)/({0:\t}NAME)+1i*{0:\w}NAME)*{0:t}NAME))&{0:t}NAME)
.EQN 0 28 264 0
{0:F12}NAME({0:\w}NAME):-{0:\t}NAME*({0:exp}NAME(-(1+1i*{0:\w}NAME*{0:\t}NAME)*({0:b}NAME)/({0:\t}NAME)))/((1+1i*{0:\w}NAME*{0:\t}NAME))+({0:\t}NAME)/((1+1i*{0:\w}NAME*{0:\t}NAME))
.TXT 7 -28 250 0
Cg a64.125000,64.000000,161
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We see that, as b goes to infinity,
 the second term of F11 and the first term
 of F12 go to zero. We "pluck" the remaining
 terms out to redefine F11 and F!2. }}
}
.EQN 8 2 251 0
{0:F1}NAME({0:\w}NAME):(-{0:\t}NAME)/((1i*{0:\w}NAME*{0:\t}NAME-1))+({0:\t}NAME)/((1+1i*{0:\w}NAME*{0:\t}NAME))
.TXT 1 33 273 0
Cg a6.250000,29.000000,12
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {Simplify:}}
}
.EQN 6 -33 272 0
{0:F1}NAME({0:\w}NAME):-2*({0:\t}NAME)/(((1i*{0:\w}NAME*{0:\t}NAME-1)*(1+1i*{0:\w}NAME*{0:\t}NAME)))
.TXT 1 33 275 0
Cg a19.750000,29.000000,28
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {Expand two denom factors:}}
}
