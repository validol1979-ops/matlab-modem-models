{\plain {3  NUMERICAL EVALUATION}}
}
.TXT 4 7 301 0
Cg a65.125000,65.000000,347
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We now numerically approximate 
the FT with the DFT. As already remarked,
 this function is not of finite time extent
 and so must be truncated and sampled. When
 we then compute the DFT, we are assuming
 that (1) the truncated sequence has been
 periodically extended. Further, the DFT
 uses the unsymmetric period- which we are
 calling DFT order.}}
}
.TXT 11 0 302 0
Cg a64.500000,65.000000,156
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {We choose a sample spacing that
 is small relative to }{\f1 t}{- this is
 reasonable- and an N that results in a 
sequence sampling "most" of the function.}}
}
.EQN 7 1 122 0
{0:N}NAME:64
.EQN 0 10 123 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 13 126 0
{0:T.s}NAME:({0:\t}NAME)/(8)
.EQN 0 10 127 0
({0:t}NAME)[({0:n}NAME):{0:n}NAME*{0:T.s}NAME
.EQN 6 -28 303 0
({0:fs}NAME)[({0:n}NAME):{0:if}NAME({0:n}NAMEó({0:N}NAME)/(2),{0:f}NAME({0:n}NAME*{0:T.s}NAME),{0:f}NAME(({0:N}NAME-{0:n}NAME)*{0:T.s}NAME))
.TXT 7 -1 129 0
Cg a59.375000,60.000000,134
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The FFT, cfft(.), in Mathcad is
 based on a DFT defined differently than
 in DSP: but we can get the one we want 
by a re-definition:}}
}
.EQN 7 5 130 0
{0:dft}NAME({0:v}NAME):\({0:N}NAME)*{0:icfft}NAME({0:v}NAME)
.TXT 6 -9 131 0
Cg a36.750000,64.000000,50
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {Now we compute the DFT approximation
 to the FT:}}
}
.EQN 5 9 132 0
{0:F.DFT}NAME:{0:dft}NAME({0:fs}NAME)
.TXT 4 -9 133 0
Cg a33.125000,64.000000,47
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {NOTE THE SPEED OF }{\ul THIS}{ 
CALCULATION!!}}
}
