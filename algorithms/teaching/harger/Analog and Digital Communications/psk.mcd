{\plain {\fs24 \ul \b Define Signal Detection
 / Demodulation }}
}
.TXT 4 0 131 0
Cg a70.500000,73.000000,395
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {To demodulate the signals we use
 a coherent receiver since the instantaneous
 frequencies of the two carrier signals 
are the same, meaning that their envelopes
 are the same.  Coherent demodulation\par 
requires that we multiply (or mix) the transmitted
 signal by cos(}{\f1 w}{c*t) and Low Pass
 Filter the resulting \par signal.  Examples
 of the mixed signals r(t) for logic 1 and
 0  are shown below.}}
}
.EQN 10 24 68 0
({0:r}NAME)[({0:n}NAME,{0:k}NAME):({0:s}NAME)[({0:n}NAME,{0:k}NAME)*2*{0:cos}NAME({0:\wc}NAME*{0:k}NAME)
