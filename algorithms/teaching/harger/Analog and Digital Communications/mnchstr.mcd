Cg b73.000000,73.000000,211
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Courier;}
{\f2\fnil Symbol;}
}
{\plain {\b Mnchstr}{\b .mcd}{   to compute
 the spectral densities (as defined) for
 the }{\b Manchester}{ line code used in
 the }{\b Ethernet}{. The expectation is
 approximated by a sample average of repeated
 trials.}}
}
.TXT 7 7 2 0
Cg a60.875000,61.875000,221
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Courier;}
{\f2\fnil Symbol;}
}
{\plain {\b 1}{  Define the discrete time
 index, the random binary sequence \{x(n)\}
 to be encoded, and the binary sequence 
\{b(n)\} of pulse amplitudes. The repeated
 trials are indexed by i. Let the probability
 of a 1 be pr.}}
}
.EQN 8 7 3 0
{0:N}NAME:16
.EQN 0 10 4 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 13 5 0
{0:I}NAME:15
.EQN 0 9 6 0
{0:i}NAME:0;{0:I}NAME-1
.EQN 0 13 7 0
{0:pr}NAME:0.5
.EQN 4 -45 8 0
({0:x}NAME)[({0:n}NAME,{0:i}NAME):{0:if}NAME({0:rnd}NAME(1)<{0:pr}NAME,1,0)
.TXT 6 -7 9 0
Cg a62.125000,63.625000,384
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Courier;}
{\f2\fnil Symbol;}
}
{\plain {The Manchester code encodes a '0'
 into 'zero-return pulse', actually one 
cycle of a square wave & a '1' into the 
opposite phase pulse. The resulting wave
 will have good synchronization properties
 and, on average, 'zero average value', 
or, ' no DC', or, 'quite low' low frequency
 content in the spectral density. So the
 binary sequence of pulse amplitudes have
 values of +/- 1 :}}
}
.EQN 14 7 10 0
({0:b}NAME)[({0:n}NAME,{0:i}NAME):{0:if}NAME(({0:x}NAME)[({0:n}NAME,{0:i}NAME)÷0,-1,1)
.TXT 6 -7 16165 0
