{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Courier;}
}
{\plain {}{\b 3}{  Compute the output pulse,
 s(t).}}
}
.EQN 5 21 16 0
({0:S}NAME)[({0:n}NAME,{0:j}NAME):({0:H}NAME)[({0:n}NAME,{0:j}NAME)*({0:P}NAME)[({0:n}NAME)
.EQN 1 -20 15 0
{0:idft}NAME({0:v}NAME):((1)/(\({0:N}NAME)))*{0:cfft}NAME({0:v}NAME)
.EQN 8 0 17 0
({0:s}NAME){52}({0:j}NAME):{0:idft}NAME(({0:S}NAME){52}({0:j}NAME))
.EQN 0 16 18 0
({0:M}NAME)[({0:j}NAME):{0:max}NAME(({0:s}NAME){52}({0:j}NAME))
