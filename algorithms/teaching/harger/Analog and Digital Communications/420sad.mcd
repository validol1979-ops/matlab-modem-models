0&-40&(-40&0)&20*{0:log}NAME(|(((({0:s}NAME){52}({0:j}NAME)))[({0:n}NAME))+0.000001)@{0:N}NAME-1&0&(0&{0:N}NAME-1)&{0:n}NAME
