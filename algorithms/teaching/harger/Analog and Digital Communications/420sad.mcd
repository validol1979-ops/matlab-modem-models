.TXT 2 1 16129 0
Cg a67.125000,73.000000,100
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Courier;}
}
{\plain {\b 420sad.mcd}{ to show the effects
 of amplitude distortion in the channel's
  frequency response.}}
}
.TXT 4 5 16130 0
Cg a60.500000,68.000000,93
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Courier;}
}
{\plain {}{\b 1}{ Define the degraded magnitude
 of the channel's frequency response- in
 'DFT form'.}}
}
.EQN 4 3 3 0
{0:N}NAME:128
.EQN 0 8 4 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 18 5 0
{0:j}NAME:0;2
.EQN 0 8 6 0
({0:\e}NAME)[({0:j}NAME):0.1*{0:j}NAME
.EQN 0 12 7 0
{0:\t}NAME:(2*{0:\p}NAME)/(8)
.EQN 5 -46 8 0
({0:A}NAME)[({0:n}NAME,{0:j}NAME):1+2*({0:\e}NAME)[({0:j}NAME)*{0:cos}NAME({0:\t}NAME*{0:n}NAME)
.EQN 0 26 9 0
({0:H}NAME)[({0:n}NAME,{0:j}NAME):{0:if}NAME({0:n}NAMEó16,({0:A}NAME)[({0:n}NAME,{0:j}NAME),{0:if}NAME({0:n}NAMEò112,({0:A}NAME)[({0:N}NAME-{0:n}NAME,{0:j}NAME),0))
.EQN 4 -24 10 0
&&(_n_u_l_l_&_n_u_l_l_)&((({0:H}NAME){52}(0)))[({0:n}NAME),((({0:H}NAME){52}(1)))[({0:n}NAME),((({0:H}NAME){52}(2)))[({0:n}NAME)@{0:N}NAME-1&0&(0&{0:N}NAME-1)&{0:n}NAME
