}
{\plain {3  NUMERICAL EVALUATION}}
}
.TXT 4 7 98 0
Cg a64.875000,65.000000,148
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {a. We can take the integral definition
 of the FT and, using built-in integration
 algorithms in Mathcad, evaluate the FT 
for a set of }{\f1 w}{. }}
}
.EQN 7 2 106 0
{0:K}NAME:64
.EQN 0 10 107 0
{0:k}NAME:0;{0:K}NAME-1
.EQN 0 14 112 0
({0:\w}NAME)[({0:k}NAME):(-5*2*{0:\p}NAME)/({0:\t}NAME)+({0:k}NAME)/({0:K}NAME)*(10*2*{0:\p}NAME)/({0:\t}NAME)
.EQN 7 -23 4 0
{0:f}NAME({0:t}NAME):{0:\F}NAME({0:t}NAME)-{0:\F}NAME({0:t}NAME-{0:\t}NAME)
.EQN 0 23 116 0
({0:Fa}NAME)[({0:k}NAME):(0&{0:\t}NAME`({0:e}NAME)^(-1i*({0:\w}NAME)[({0:k}NAME)*{0:t}NAME)*{0:f}NAME({0:t}NAME)&{0:t}NAME)
.TXT 6 -25 120 0
Cg a44.250000,64.000000,67
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {Note the time that is required 
to compute this set of integrals!}}
}
.TXT 5 -1 121 0
Cg a64.250000,65.000000,110
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {b.  Now let us approximate the 
integral using the "rectangle rule". We 
use the "samples" of the integrand.}}
}
.EQN 7 1 122 0
{0:N}NAME:64
.EQN 0 10 123 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 0 13 126 0
{0:T.s}NAME:4*({0:\t}NAME)/({0:N}NAME)
.EQN 0 10 127 0
({0:t}NAME)[({0:n}NAME):{0:n}NAME*{0:T.s}NAME
.EQN 0 15 125 0
({0:fs}NAME)[({0:n}NAME):{0:f}NAME(({0:t}NAME)[({0:n}NAME))
.EQN 7 -48 149 0
{0:k}NAME:0;{0:N}NAME-1
.EQN 0 12 150 0
({0:\w}NAME)[({0:k}NAME):({0:k}NAME-({0:N}NAME)/(2))*((2*{0:\p}NAME)/(4*{0:\t}NAME))
.EQN 0 21 124 0
({0:Fr}NAME)[({0:k}NAME):((0,{0:N}NAME-1,{0:n}NAME,({0:e}NAME)^(-1i*({0:\w}NAME)[({0:k}NAME)*({0:t}NAME)[({0:n}NAME))*({0:fs}NAME)[({0:n}NAME)*{0:T.s}NAME){64})
.TXT 8 -33 154 0
Cg a63.000000,64.000000,209
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {Note that the calculation, again,
 is faster. But we recognize that the basic
 computation is the DFT- and Mathcad has
 a fast algorithm for it! Note that we deliberately
 chose }{\f1 w}{\fs16 \dn6 k}{ so that}}
}
.EQN 8 17 168 0
({0:\w}NAME)[({0:k}NAME)*({0:t}NAME)[({0:n}NAME):(2*{0:\p}NAME)/({0:N}NAME)*{0:k}NAME*{0:n}NAME
