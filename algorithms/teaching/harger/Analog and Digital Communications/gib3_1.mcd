{\plain {\b Gib3_1.mcd}{   The Fourier transform
 of a "square pulse" will be evaluated by
 four methods:\par      1.  analytic evaluation
 "with paper and pencil and integral tables"
 }{\par      2.  evaluation using the symbolic
 math capability of Mathcad\par      3. 
 numerical evaluation by \par           
a. Mathcad's built-in integration capability\par 
          b. By DFT, using Mathcad's built-in
 FFT.}}
}
.TXT 15 8 21 0
Cg a25.500000,84.875000,38
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
}
{\plain {The square pulse to be evaluated
 is}}
}
.EQN 4 7 23 0
{0:\t}NAME:1
.EQN 0 8 24 0
{0:V}NAME:1
.EQN 0 9 69 0
{0:f}NAME({0:t}NAME):{0:\F}NAME({0:t}NAME)-{0:\F}NAME({0:t}NAME-{0:\t}NAME)
