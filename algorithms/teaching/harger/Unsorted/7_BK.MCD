{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {\b \ulnone Property 7.3: Time Delay}{
  }{Given a sequence }{\{h}{\fs16 \dn8 n}{,
 }{n=0,1,...\} with DTFT H1(}{\f1 w}{)}{,
 the    DTFT of the translated sequence 
}{\{hed}{\fs16 \dn8 n-nd}{, }{n=0,1,...\},
 nd>=0 an integer, is \par exp(-i}{\f1 w}{nd)
 H1(}{\f1 w}{).}}
}
