{\plain {\b Property 7.8  Multiplication
 in Time}{  The DTFT of a product of sequences,
 \par z}{\fs16 \dn6 n}{ = w}{\fs16 \dn6 
n}{ x}{\fs16 \dn6 n}{ , is the periodic 
convolution of the DTFTs of w}{\fs16 \dn6 
n}{ and x}{\fs16 \dn6 n}{. }}
}
.EQN 8 7 223 0
{0:Z1}NAME({0:\w}NAME):(1)/(2*{0:\p}NAME)*(0&2*{0:\p}NAME`{0:W1}NAME({0:\w}NAME-{0:u}NAME)*{0:X1}NAME({0:u}NAME)&{0:u}NAME)
.TXT 5 -7 224 0
Cg a56.875000,64.000000,102
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {To prove this we compute the DTFT
 Z1(}{\f1 w}{) using the IDTFT representation
 of x}{\fs16 \dn6 n}{.}}
}
.EQN 5 6 225 0
{0:Z1}NAME({0:\w}NAME):{0:n}NAME$({0:e}NAME)^(-1i*{0:\wn}NAME)*({0:w}NAME)[({0:n}NAME)*(1)/(2*{0:\p}NAME)*(0&2*{0:\p}NAME`({0:e}NAME)^(1i*{0:u}NAME*{0:n}NAME)*{0:X1}NAME({0:u}NAME)&{0:u}NAME)
