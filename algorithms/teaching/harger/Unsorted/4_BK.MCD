{\plain {\b \ulnone Property 4.7: IDFT of
 a product of DFTs}{  Let \{x}{\dn8 n}{,
 n = 0,...,N-1\} and\par }{ \{h}{\dn8 n}{,
 n = 0,...,N-1\} have DFTs \{X}{\dn8 k}{\}
 and \{H}{\dn8 k}{\}, resp. Let \{Y}{\dn8 
k}{=X}{\dn8 k}{ H}{\dn8 k}{\}. Then the 
IDFT of \{Y}{\dn8 k}{\}, \{y}{\dn8 n}{, 
n = 0,...,N-1\}, is the periodic convolution
 of }{ \{x}{\dn8 n}{, n = 0,...,N-1\} and
 \par }{\{h}{\dn8 n}{, n = 0,...,N-1\}.}}
}
.TXT 12 0 70 0
Cg a62.250000,61.875000,481
{\rtf1\ansi \deff0
