.TXT 6 -29 143 0
Cg a60.375000,61.000000,353
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {The DFT and, it follows, the IDFT,
 have a number of symmetries that can be
 useful in reducing the amount of required
 computation. We now discuss some of these
 for real sequences. }{Note that it is sensible
 to discuss a symmetry property about k=0
 for a DFT: while it is computed explicitly
 for k=0,...,N-1, it is a periodic sequence
 of period N. }}
}
.TXT 12 0 144 0
Cg a61.250000,61.000000,285
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {\b \ulnone Property 4.2: Symmetries}{
  Assume that \{f}{\dn8 n}{, n = 0,...,N-1\}
 is a real sequence with   DFT  \{F}{\dn8 
k}{\}. Then \{F}{\dn8 k}{\} is Hermitian
 symmetric, i.e., F}{\dn8 -k}{ = F}{\dn8 
k}{*, which may be              expressed
 as   F}{\dn8 N - k}{ = F}{\dn8 k}{*. }}
}
.TXT 10 0 24 0
Cg a60.875000,62.000000,268
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {To prove this asserted property,
 simply express the complex conjugate, F}{\dn8 
k}{*, of the DFT F}{\dn8 k}{ using the latter's
 }{\ul \b definition (3.3)}{ and thereby
 note that it is F}{\dn8 -k}{. But, by the
 periodicity of the DFT, F}{\dn8 -k}{ = 
F}{\dn8 -k+N}{.}}
}
.ATT
.STATUS Go to Section 3, p. 3
.GOTO 3_bk.mcd
.ATT_END
