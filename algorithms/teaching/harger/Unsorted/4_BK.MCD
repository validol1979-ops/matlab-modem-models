{\plain {\b \ulnone Property 4.1: Periodicity}{\ulnone 
  The DFT and IDFT sequences have period
 N.}}
}
.TXT 4 0 15 0
Cg a60.875000,61.000000,509
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
