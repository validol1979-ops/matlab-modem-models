({0:H}NAME)[({0:k}NAME):((0,{0:M}NAME-1,{0:m}NAME,{0:exp}NAME(-(1i*((2*{0:\p}NAME)/({0:N}NAME))*{0:k}NAME*{0:m}NAME))*({0:h}NAME)[({0:m}NAME)){64})
