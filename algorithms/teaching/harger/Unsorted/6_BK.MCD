{\plain {\b \ulnone \f0 Exercise 6.1}{\f0 
  Choose a sequence of increasing N in the
 illustration and observe the  apparent 
limit. (}{\ul \f0 Then reset N to 64}{\f0 
.)}}
}
.TXT 5 0 11 0
Cg a60.500000,62.000000,295
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {As we increase N, it appears that
 the plots are }{an increasingly dense sampling
 of a continuous function defined over [0,2}{\f1 
p}{]. This continuous function is obtained
 simply by }{replacing }{\f1 w}{\fs16 \dn8 
k}{ = (2}{\f1 p}{/N)k by the continuous 
variable }{\f1 w}{ in (6.2). It is}{ }}
}
.EQN 9 9 123 0
{0:H1}NAME({0:\w}NAME):((0,{0:M}NAME-1,{0:m}NAME,{0:exp}NAME(-(1i*({0:\w}NAME*{0:m}NAME)))*({0:h}NAME)[({0:m}NAME)){64})
.TXT 1 49 15 0
Cg a3.250000,8.000000,8
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {(6.3)}}
}
.TXT 6 -58 16 0
Cg a58.875000,62.125000,386
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {H1, defined by (6.3), is the}{\b 
 d}{\b \i0 iscrete time Fourier transform,}{\b 
\i0  DTFT}{, of the finite sequence \{h}{\dn8 
m}{, m=0,...,M-1\}. In the DSP context, 
where the finite sequence is an (FIR) impulse
 response, H1(}{\f1 w}{) is called the}{\b 
 }{\i0 \b frequency response (FR}{). We 
note some basic attributes of the DTFT, 
which is well defined by the finite sum 
(6.3).}}
}
.TXT 10 0 285 0
Cg a59.000000,61.000000,124
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {\b \ulnone Property 6.1}{  H1(}{\f1 
w}{) depends on }{\f1 w}{ only as exp(i}{\f1 
w}{) and may be written H(exp(i}{\f1 w}{)).}}
}
.TXT 3 0 286 0
Cg a26.250000,61.000000,39
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {We note that we can rewrite (6.3)
 as}}
}
.EQN 5 8 124 0
{0:H1}NAME({0:\w}NAME):((0,{0:M}NAME-1,{0:m}NAME,((({0:e}NAME)^({0}1i*{0:\w}NAME)))^(-{0:m}NAME)*({0:h}NAME)[({0:m}NAME)){64})
.TXT 0 50 126 0
Cg a3.250000,7.000000,8
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {(6.4)}}
}
.TXT 7 -58 127 0
Cg a58.875000,59.500000,124
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {\b \ulnone Property 6.2}{  The 
DTFT has period 2}{\f1 p}{ and hence one
 may take }{\f1 w}{ in, e.g., [-}{\f1 p}{,}{\f1 
p}{].}}
}
.TXT 3 0 128 0
Cg a56.000000,56.375000,124
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {We note that exp[i(}{\f1 w}{+2}{\f1 
p}{)m]=exp(i}{\f1 w}{m) [exp(i2}{\f1 p}{)]}{\fs16 
\up6 m}{ and the second factor is 1.}}
}
.TXT 3 0 129 0
Cg a50.500000,53.000000,84
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {\b \ulnone Property 6.3}{  The 
DTFT and every finite order derivative is
 continuous.}}
}
.TXT 3 0 130 0
Cg a59.625000,62.125000,115
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {This Property follows from that
 of \{exp(i}{\f1 w}{m}{), m=0,...,M-1\} 
and their }{\ulnone finite}{, weighted sum.}}
}
.TXT 5 0 131 0
Cg a61.250000,61.000000,139
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {\b \ulnone Property 6.4}{  H(z)
 is a rational function of z, with a pole
 of order (M-1) at z=0 and     (M-1) zeros,
 which may be complex. }}
}
.TXT 5 0 132 0
Cg a9.375000,36.250000,15
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {We note that}}
}
.EQN 5 11 133 0
{0:H}NAME({0:z}NAME):((0,{0:M}NAME-1,{0:m}NAME,({0:h}NAME)[({0:m}NAME)*({0:z}NAME)^(-{0:m}NAME)){64})
