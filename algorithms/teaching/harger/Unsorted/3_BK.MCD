{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {W}{e click on and enclose this 
expression. Then we choose }{\b Evaluate
 Symbolically}{ from the}{\b  S}{\b ymbolic}{
 menu. Then choose }{\b S}{\b implify}{ 
from the Symbolic menu. We get, after discarding
 intermediate forms, the result}}
}
.EQN 10 18 173 0
((({0:a}NAME)^({0:N}NAME)-1))/(({0:a}NAME-1))
.TXT 5 -18 174 0
