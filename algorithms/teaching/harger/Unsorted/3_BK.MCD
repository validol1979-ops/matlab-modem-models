.TXT 30 -3 325 0
Cg a62.000000,63.125000,268
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {We know that a complex exponential
 with a frequency other than (2}{\f1 p}{/N)k,
 where k is an integer, cannot be orthogonal
 to any of the basis complex exponentials
 and so will have all nonzero DFT values,
 the projections. This is referred to as
 }{\b0 leakage}{. }}
}
