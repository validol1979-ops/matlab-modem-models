.TXT 3 10 252 0
Cg a61.625000,62.000000,405
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {The DFT is an important numerical
 algorithm. But it is useful for analysis
 and checking  to have a collection of DFT-IDFT
 pairs. These can be derived by hand or 
by using Mathcad's sy}{mbolic mathematics
 capability. In itself it is useful to learn
 how to use symbolic mathematics  software}{.
 Construct a table of DFTs. Some entries
 are suggested: these are sequences defined
 for n and k in [0,N-1].}}
}
.TXT 12 0 344 0
Cg a52.250000,62.000000,750
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil CG Times;}
}
{\plain {              }{\b  IDFT    }{ 
                                        
        }{\b  DFT}{\par \par            
    1                                   
                         }{\f1 d}{(k,0)\par 
               }{\f1 d}{(n)             
                                        
    1          \par                exp}{(i(2}{\f1 
p}{/N)}{\f1 k}{n), exp(i}{\f1 a}{n)     
                       N }{\f1 d}{(}{\f1 
k}{,k), (eq. 3.8)\par                cos}{((2}{\f1 
p}{/N)}{\f1 k}{n), cos(}{\f1 a}{n)\par  
              sin}{((2}{\f1 p}{/N)}{\f1 
k}{n), sin(}{\f1 a}{n)}{\par            
    a}{\fs16 \up6 n }{                  
                                        
 (eq. 3.8)\par                }{\f1 F}{(n,0)
 - }{\f1 F}{(n,M)                       
                 (Exercise 3.7)}}
}
