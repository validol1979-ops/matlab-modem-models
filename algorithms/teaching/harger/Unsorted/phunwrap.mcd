.TXT 5 5 3 0
Cg a22.875000,68.000000,37
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil Courier;}
}
{\plain {\b 1}  Define the phase modulation.}
}
.EQN 4 3 54 0
{0:N}NAME:256
.EQN 0 9 55 0
{0:n}NAME:0;{0:N}NAME-1
.EQN 5 -9 57 0
{0:\w.1}NAME:(2*{0:\p}NAME)/({0:N}NAME)*3
.EQN 0 12 58 0
{0:\w.2}NAME:(2*{0:\p}NAME)/({0:N}NAME)*4
.EQN 0 18 4 0
({0:m}NAME)[({0:n}NAME):{0:sin}NAME({0:\w.1}NAME*{0:n}NAME)+2*{0:sin}NAME({0:\w.2}NAME*{0:n}NAME)
.TXT 8 -33 8 0
Cg a65.875000,68.000000,190
{\rtf1\ansi \deff0
{\fonttbl
{\f0\fnil Arial;}
{\f1\fnil Symbol;}
{\f2\fnil Courier;}
}
{\plain {\b 2}  the result of phase modulation-
 with phase deviation {\f1 m}, ideal transmission,
 and reception with in-phase and quadrature
 mixers is the ordered pair, or "complex"
 data sequences}
}
.EQN 7 3 14 0
{0:\m}NAME:1
.EQN 0 8 9 0
({0:r}NAME)[({0:n}NAME):{0:cos}NAME({0:\m}NAME*({0:m}NAME)[({0:n}NAME))
.EQN 0 20 10 0
({0:q}NAME)[({0:n}NAME):{0:sin}NAME({0:\m}NAME*({0:m}NAME)[({0:n}NAME))
.EQN 0 17 59 0
({0:c}NAME)[({0:n}NAME):({0:r}NAME)[({0:n}NAME)+1i*({0:q}NAME)[({0:n}NAME)
.TXT 7 -48 36 0
Cg a65.250000,68.000000,93
{\rtf1\ansi \deff0
